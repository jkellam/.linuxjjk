#!/usr/bin/env bash
##============================================================================
##  init -- install and verify the hooks my portable linux setup needs.
##
##  Safe to run as many times as you like.  It changes nothing that is already
##  correct; it reports on what it finds and only creates what is missing.
##
##  Nothing here depends on this directory being called ".linuxjjk" -- every
##  path is derived from SCRIPT_DIR below.
##============================================================================
set -u

SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")


##============================================================================
##  Colors.  Suppressed when stdout is not a terminal so that redirecting the
##  output to a file does not fill it with escape sequences.
##============================================================================
if [[ -t 1 ]]; then
    C_RED=$'\e[0;31m'
    C_GREEN=$'\e[0;32m'
    C_YELLOW=$'\e[1;33m'
    C_NC=$'\e[0m'
else
    C_RED='' C_GREEN='' C_YELLOW='' C_NC=''
fi

##----------------------------------------------------------------------------
##  Pure printers -- these only print.  Tallying is done by the callers so
##  that one problem cannot get counted twice by a helper and its caller.
##
##  red() and yellow() also arm cont(), which prints the follow-on lines of a
##  multi-line message in the same color and indented past the prefix, so a
##  warning reads as one yellow block rather than one colored line trailed by
##  uncolored text.  Indents match the prefix the caller printed:
##  "ERROR: " is 7 columns, "WARNING: " is 9.
##----------------------------------------------------------------------------
CONT=''
CONT_COLOR=''

red()    { CONT='       '   CONT_COLOR="$C_RED";    printf '%s\n' "${C_RED}${1}${C_NC}"; }
yellow() { CONT='         ' CONT_COLOR="$C_YELLOW"; printf '%s\n' "${C_YELLOW}${1}${C_NC}"; }
green()  { printf '%s\n' "${C_GREEN}${1}${C_NC}"; }
cont()   { printf '%s\n' "${CONT_COLOR}${CONT}${1}${C_NC}"; }
info()   { printf '%s\n' "$1"; }

ERRORS=0
WARNINGS=0

##----------------------------------------------------------------------------
##  Print a problem at the requested severity and tally it exactly once.
##  Callers pass "error" or "warn" so that the same check can be fatal for one
##  file and merely advisory for another.
complain() {
    local level="$1" msg="$2"
    if [[ $level == error ]]; then
        red "ERROR: $msg"
        ERRORS=$((ERRORS + 1))
    else
        yellow "WARNING: $msg"
        WARNINGS=$((WARNINGS + 1))
    fi
}

##----------------------------------------------------------------------------
##  Shorten $HOME to ~ for display.  The tilde must be backslash-escaped: an
##  unquoted ~ in the replacement half of a substitution gets tilde-expanded
##  back into $HOME, which silently makes this a no-op.
##----------------------------------------------------------------------------
tildify() { printf '%s' "${1/#$HOME/\~}"; }

##----------------------------------------------------------------------------
##  Ask a yes/no question.  Returns non-zero on "no", and also on EOF so that
##  running this non-interactively declines rather than hangs forever.
##----------------------------------------------------------------------------
confirm() {
    local prompt="$1" reply
    read -r -p "$prompt [y/N] " reply || return 1
    [[ $reply == [Yy] || $reply == [Yy][Ee][Ss] ]]
}


##============================================================================
##  ~/.gitid -- this machine's git identity.
##
##  Deliberately NOT part of the portable directory: it is the one piece of
##  git config that must differ per machine.
##============================================================================
GITID="$HOME/.gitid"
GITID_SHOWN=$(tildify "$GITID")

##----------------------------------------------------------------------------
##  Where to read about what ~/.gitid needs to contain.
##----------------------------------------------------------------------------
gitid_help() {
    cont "$GITID_SHOWN needs at least this:"
    info ""
    info "           [user]"
    info "               name = Your Name"
    info "               email = you@example.com"
    info ""
    cont "The header comment in $(tildify "$SCRIPT_DIR")/.gitconfig has the full story,"
    cont "or re-run $(tildify "$SCRIPT_DIR")/init to be prompted for it."
}

##----------------------------------------------------------------------------
##  Let git itself parse the file rather than grepping it -- if git can read
##  the values then git will use them, which is the only definition of "valid"
##  that actually matters.
##----------------------------------------------------------------------------
validate_gitid() {
    local name email problems=() p

    if ! git config -f "$GITID" --list >/dev/null 2>&1; then
        red "ERROR: $GITID_SHOWN is not valid git config syntax."
        cont "Run this to see what git chokes on:"
        cont "    git config -f $GITID_SHOWN --list"
        return 1
    fi

    name=$(git config -f "$GITID" --get user.name 2>/dev/null)
    email=$(git config -f "$GITID" --get user.email 2>/dev/null)

    [[ -n $name ]]  || problems+=("user.name is missing or empty")
    [[ -n $email ]] || problems+=("user.email is missing or empty")

    if [[ -n $email ]] && [[ ! $email =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]; then
        problems+=("user.email does not look like an email address: '$email'")
    fi

    if (( ${#problems[@]} > 0 )); then
        red "ERROR: $GITID_SHOWN is not valid:"
        for p in "${problems[@]}"; do
            cont "- $p"
        done
        gitid_help
        return 1
    fi

    green "$GITID_SHOWN valid  ($name <$email>)"
    return 0
}

##----------------------------------------------------------------------------
##  Prompt for the identity and write the file.
##----------------------------------------------------------------------------
create_gitid() {
    local name email

    read -r -p "  Full name for git commits: " name || return 1
    read -r -p "  Email for git commits: " email || return 1

    ##------------------------------------------------------------------------
    ##  Trim surrounding whitespace -- easy to paste in by accident, and it
    ##  would otherwise end up baked into every commit.
    ##------------------------------------------------------------------------
    name="${name#"${name%%[![:space:]]*}"}";    name="${name%"${name##*[![:space:]]}"}"
    email="${email#"${email%%[![:space:]]*}"}"; email="${email%"${email##*[![:space:]]}"}"

    if [[ -z $name || -z $email ]]; then
        red "ERROR: both a name and an email are required; nothing was written."
        return 1
    fi

    if ! cat > "$GITID" <<EOF
##----------------------------------------------------------------------------
##  This machine's git identity, created by $(tildify "$SCRIPT_DIR")/init and
##  pulled in by the [include] in the portable .gitconfig.
##
##  Machine-local on purpose -- do NOT copy this file between machines.
##----------------------------------------------------------------------------
[user]
    name = $name
    email = $email
EOF
    then
        red "ERROR: could not write $GITID_SHOWN."
        return 1
    fi

    green "$GITID_SHOWN created"
    return 0
}

check_gitid() {
    ##------------------------------------------------------------------------
    ##  Missing entirely -- offer to build it.  Yellow, not red: on a fresh
    ##  machine this is the expected state, and we are about to fix it.  Red is
    ##  reserved for a file that is still missing or bad once init is done.
    ##------------------------------------------------------------------------
    if [[ ! -e $GITID ]]; then
        yellow "WARNING: $GITID_SHOWN is missing -- git has no identity to commit under."

        if confirm "  Create it now?"; then
            ##----------------------------------------------------------------
            ##  On failure create_gitid/validate_gitid have already printed the
            ##  red reason, so just tally it here.
            ##----------------------------------------------------------------
            create_gitid && validate_gitid && return 0
            ERRORS=$((ERRORS + 1))
            return 1
        fi

        red "ERROR: $GITID_SHOWN was not created -- you'll need to make it later."
        gitid_help
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    if [[ ! -r $GITID ]]; then
        red "ERROR: $GITID_SHOWN exists but cannot be read."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    validate_gitid && return 0
    ERRORS=$((ERRORS + 1))
    return 1
}


##============================================================================
##  Dotfiles in $HOME that should be nothing but symlinks into this directory.
##
##      $1  the link to check or create, e.g. $HOME/.gitconfig
##      $2  what it should point at, e.g. $SCRIPT_DIR/.gitconfig
##      $3  "error" or "warn" -- how loudly to complain when something is
##          already there and it is not our symlink
##============================================================================
check_portable_symlink() {
    local link="$1" target="$2" level="$3"
    local shown target_shown points_to name
    shown=$(tildify "$link")
    target_shown=$(tildify "$target")
    name=$(basename "$target")

    ##------------------------------------------------------------------------
    ##  A missing source file is always an error, whatever the level: it means
    ##  this directory itself is incomplete.
    ##------------------------------------------------------------------------
    if [[ ! -e $target ]]; then
        red "ERROR: $target_shown does not exist -- this directory looks incomplete."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  Test for a symlink BEFORE testing existence: -e is false for a symlink
    ##  whose target is gone, and a dangling link is a case worth naming.
    ##------------------------------------------------------------------------
    if [[ -L $link ]]; then
        points_to=$(realpath -m "$link")

        if [[ $points_to == "$(realpath "$target")" ]]; then
            green "$shown properly configured (symlink -> $target_shown)"
            return 0
        fi

        if [[ ! -e $link ]]; then
            complain "$level" "$shown is a dangling symlink -> $(tildify "$points_to")"
            cont "Remove it and re-run this script to link it correctly."
        else
            complain "$level" "$shown is a symlink, but points to $(tildify "$points_to")"
            cont "Expected it to point to $target_shown."
            cont "To switch over, remove it and re-run this script:"
            cont "    rm $shown && $(tildify "$SCRIPT_DIR")/init"
        fi
        return 1
    fi

    if [[ -f $link ]]; then
        complain warn "$shown is a regular file, so this machine is not using the"
        cont "portable $name at $target_shown."
        cont "To switch over, move it aside and re-run this script:"
        cont "    mv $shown $shown.bak && $(tildify "$SCRIPT_DIR")/init"
        return 1
    fi

    if [[ -e $link ]]; then
        complain "$level" "$shown exists but is neither a regular file nor a symlink."
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  Nothing there at all -- the one case where we get to just fix it.
    ##------------------------------------------------------------------------
    if ln -s "$target" "$link"; then
        green "$shown symlink created (-> $target_shown)"
        return 0
    fi

    red "ERROR: could not create the $shown symlink."
    ERRORS=$((ERRORS + 1))
    return 1
}


##============================================================================
##  Getting bashrc_jjk sourced by every new interactive shell.
##
##  Two mechanisms, picked by what the machine actually offers:
##
##    1. Some distros (Fedora and friends) ship a ~/.bashrc that loops over
##       everything in ~/.bashrc.d.  Where that exists we just drop a symlink
##       in there and never touch ~/.bashrc at all.
##    2. Everywhere else, a marker-delimited block appended to ~/.bashrc.  The
##       markers are what make it re-runnable: init rewrites what is between
##       them instead of appending a second copy.
##
##  The test is whether something really loops over the directory -- NOT
##  whether the directory exists.  A ~/.bashrc.d that nothing sources would
##  make the drop-in silently dead.
##============================================================================
BASHRC="$HOME/.bashrc"
DROPIN_NAME='50-linuxjjk.sh'
MARK_BEGIN='## >>> linuxjjk >>>'
MARK_END='## <<< linuxjjk <<<'

bashrc_d_is_looped() {
    local f
    for f in "$BASHRC" /etc/bashrc /etc/bash.bashrc; do
        [[ -r $f ]] || continue
        ##--------------------------------------------------------------------
        ##  Looking for a glob over the whole directory, e.g.
        ##      for rc in ~/.bashrc.d/*; do
        ##  A line naming one specific file in there is somebody's hand-rolled
        ##  hook for that file, not a general loop, so it does not count.
        ##--------------------------------------------------------------------
        grep -qE '^[^#]*\.bashrc\.d[^/]?/\*' "$f" && return 0
    done
    return 1
}

##----------------------------------------------------------------------------
##  Print $BASHRC with our managed block removed.
##----------------------------------------------------------------------------
bashrc_without_block() {
    [[ -f $BASHRC ]] || return 0
    awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
        $0 == b { skip = 1 }
        skip    { if ($0 == e) { skip = 0 }; next }
                { print }
    ' "$BASHRC"
}

##----------------------------------------------------------------------------
##  Exactly what the block should contain, and exactly what is in the file
##  right now.  Comparing the two whole blocks -- rather than grepping the
##  file for our path -- means a half-edited block counts as wrong instead of
##  passing because the right path still appears somewhere inside it.
##----------------------------------------------------------------------------
bashrc_block_body() {
    printf '%s\n' "$MARK_BEGIN"
    printf '%s\n' "##  Managed by $(tildify "$SCRIPT_DIR")/init -- edits between these markers are lost."
    printf '%s\n' "[ -f \"$SCRIPT_DIR/bashrc_jjk\" ] && . \"$SCRIPT_DIR/bashrc_jjk\""
    printf '%s\n' "$MARK_END"
}

extract_bashrc_block() {
    [[ -f $BASHRC ]] || return 0
    awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
        $0 == b { s = 1 }
        s       { print }
        $0 == e { s = 0 }
    ' "$BASHRC"
}

##----------------------------------------------------------------------------
##  Write the block, replacing any previous copy of it.  Writes through the
##  existing file rather than mv-ing a new one into place, so a ~/.bashrc that
##  is itself a symlink stays a symlink and keeps its mode.
##----------------------------------------------------------------------------
install_bashrc_block() {
    local tmp
    tmp=$(mktemp "${BASHRC}.linuxjjk.XXXXXX") || return 1

    ##  One backup, the first time we ever touch this file.
    if [[ -f $BASHRC && ! -e "$BASHRC.linuxjjk.bak" ]]; then
        cp -p "$BASHRC" "$BASHRC.linuxjjk.bak" || { rm -f "$tmp"; return 1; }
    fi

    {
        bashrc_without_block
        bashrc_block_body
    } > "$tmp" || { rm -f "$tmp"; return 1; }

    cat "$tmp" > "$BASHRC" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
}

##----------------------------------------------------------------------------
##  Anything ELSE in ~/.bashrc that sources a shell config file by name will
##  run alongside ours and can override it.  A distro's own loop over the
##  directory is fine and is excluded here; a line naming one file is not.
##----------------------------------------------------------------------------
warn_competing_hooks() {
    local hits line shown
    shown=$(tildify "$BASHRC")
    [[ -f $BASHRC ]] || return 0

    hits=$(bashrc_without_block \
        | grep -E '^[^#]*(\.|source)[[:space:]]+[^[:space:]]*(bashrc_jjk|\.bashrc\.d/[^*[:space:]]+)') || return 0
    [[ -n $hits ]] || return 0

    complain warn "$shown has its own line(s) sourcing a shell config directly:"
    while IFS= read -r line; do
        cont "    ${line#"${line%%[![:space:]]*}"}"
    done <<< "$hits"
    cont "Those run alongside the linuxjjk setup and can override it."
    return 1
}

##----------------------------------------------------------------------------
##  The only check that proves the hook works: start a fresh interactive bash
##  and ask it what it loaded.  LINUXJJK_LOADED/_DIR are unset first so the
##  child cannot inherit them from whatever shell is running init.
##----------------------------------------------------------------------------
verify_bashrc_hook() {
    local raw probe rest count dir cmd=()

    ##------------------------------------------------------------------------
    ##  Spawning an interactive shell from a script is a trap, and all three
    ##  of these guards are load-bearing:
    ##
    ##    setsid -w  -- give the probe its own session, so it has no
    ##                  controlling terminal to fight over.  Without this,
    ##                  bash -i tries to take the terminal with tcsetpgrp(),
    ##                  is not the foreground process group, takes SIGTTOU and
    ##                  STOPS.  init then waits on it forever, and Ctrl-C
    ##                  cannot help because the signal goes to the terminal's
    ##                  foreground group, not to the stopped probe.
    ##    </dev/null  -- never let the probe read from the terminal.
    ##    timeout -k  -- an interactive bash IGNORES SIGTERM, so plain timeout
    ##                  cannot end it.  The KILL escalation is what actually
    ##                  guarantees this function returns.
    ##------------------------------------------------------------------------
    if command -v setsid >/dev/null 2>&1 && setsid -w /bin/true >/dev/null 2>&1; then
        cmd+=(setsid -w)
    fi
    command -v timeout >/dev/null 2>&1 && cmd+=(timeout -k 5 15)
    cmd+=(env -u LINUXJJK_LOADED -u LINUXJJK_DIR
          bash -ic 'printf "__LINUXJJK_PROBE__ %s %s\n" "${LINUXJJK_LOADED:-0}" "${LINUXJJK_DIR:-}"')

    ##------------------------------------------------------------------------
    ##  Tag the answer.  A shell's startup files print their own things to
    ##  stdout (Ubuntu's sudo hint, motd fragments, banners), so picking a
    ##  line by position reads somebody else's output.
    ##------------------------------------------------------------------------
    raw=$("${cmd[@]}" </dev/null 2>/dev/null)

    probe=$(printf '%s\n' "$raw" | grep '^__LINUXJJK_PROBE__ ' | tail -n 1)
    if [[ -z $probe ]]; then
        complain warn "could not run an interactive bash to verify the hook."
        return 1
    fi

    rest=${probe#__LINUXJJK_PROBE__ }
    count=${rest%% *}
    dir=${rest#* }
    [[ $count =~ ^[0-9]+$ ]] || count=0

    if (( count == 0 )); then
        red "ERROR: a new interactive bash does not load bashrc_jjk."
        cont "The hook is installed but is not firing.  Check $(tildify "$BASHRC")."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    if [[ $dir != "$SCRIPT_DIR" ]]; then
        red "ERROR: a new interactive bash loads bashrc_jjk from $(tildify "$dir")"
        cont "Expected $(tildify "$SCRIPT_DIR") -- there are two copies of this setup installed."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    if (( count > 1 )); then
        complain warn "bashrc_jjk is loaded $count times by a new shell, so more than one hook is installed."
        cont "Harmless but wasteful -- remove the extra one."
        return 1
    fi

    green "a new interactive bash loads bashrc_jjk once, from $(tildify "$SCRIPT_DIR")"
    return 0
}

check_bashrc_hook() {
    local shown
    shown=$(tildify "$BASHRC")

    if bashrc_d_is_looped; then
        ##--------------------------------------------------------------------
        ##  The distro sources the directory for us, so ~/.bashrc stays
        ##  untouched.  Note the name must not start with a dot: the loop
        ##  globs ~/.bashrc.d/*, which does not match dotfiles.
        ##--------------------------------------------------------------------
        local dropin_dir="$HOME/.bashrc.d"
        if [[ ! -d $dropin_dir ]] && ! mkdir -p "$dropin_dir"; then
            red "ERROR: could not create $(tildify "$dropin_dir")."
            ERRORS=$((ERRORS + 1))
            return 1
        fi
        check_portable_symlink "$dropin_dir/$DROPIN_NAME" "$SCRIPT_DIR/bashrc_jjk" error

    elif [[ -f $BASHRC ]] && grep -Fxq "$MARK_BEGIN" "$BASHRC"; then
        ##--------------------------------------------------------------------
        ##  Our block is already there.  It is ours to rewrite, so a stale
        ##  path just gets corrected rather than reported as a problem.
        ##--------------------------------------------------------------------
        if [[ "$(extract_bashrc_block)" == "$(bashrc_block_body)" ]]; then
            green "$shown sources $(tildify "$SCRIPT_DIR")/bashrc_jjk"
        elif install_bashrc_block; then
            green "$shown block repointed at $(tildify "$SCRIPT_DIR")/bashrc_jjk"
        else
            red "ERROR: could not update the linuxjjk block in $shown."
            ERRORS=$((ERRORS + 1))
        fi

    elif install_bashrc_block; then
        green "$shown block added, sourcing $(tildify "$SCRIPT_DIR")/bashrc_jjk"

    else
        red "ERROR: could not add the linuxjjk block to $shown."
        ERRORS=$((ERRORS + 1))
    fi

    warn_competing_hooks
    verify_bashrc_hook
}


##============================================================================
##  VS Code setup (the Brief/SlickEdit parity work).
##
##  vscode-setup/ ships its own health check and installer, so init does not
##  reimplement any of it:
##
##      check-install.sh  reports only, changes nothing, exit 0 == healthy
##      install.sh        does the work; refuses to run while VS Code is open
##
##  So: run the check, and only reach for the installer if the check fails.
##  That is what makes re-running init cheap on a machine already set up.
##============================================================================
VSCODE_DIR_NAME='vscode-setup'
VSCODE_USER_DIR="$HOME/.config/Code/User"

##----------------------------------------------------------------------------
##  check-install.sh answers "is the install intact?".  It deliberately cannot
##  answer "is the install made from the CURRENT contents of this folder?" --
##  a keybindings.json that differs is only a [warn] there, on purpose, because
##  from its point of view the difference is ambiguous: the folder might be
##  newer, or the active file might have been edited deliberately.
##
##  So init keeps its own record.  After a successful install it stamps a hash
##  of the files that decide what gets installed; a shipped hash that no longer
##  matches the stamp means this folder changed since this machine was last set
##  up -- e.g. it was edited on another box and copied back -- and the install
##  needs redoing.
##
##  The stamp is machine-local ON PURPOSE.  It must not live inside the
##  portable directory, or it would travel along with the very changes it is
##  supposed to detect.
##----------------------------------------------------------------------------
VSCODE_STAMP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linuxjjk"
VSCODE_STAMP="$VSCODE_STAMP_DIR/vscode.stamp"

##----------------------------------------------------------------------------
##  Hash the payload -- the files that actually get installed somewhere.
##
##  Deliberately NOT install.sh / check-install.sh / source/ / the .md: those
##  are the tooling and the notes, nothing installs them, so editing a comment
##  in one must not force a reinstall.  A genuinely broken install is still
##  caught by check-install.sh on its own terms.
##----------------------------------------------------------------------------
vscode_payload_hash() {
    local dir="$1" hasher f

    for hasher in sha256sum sha1sum md5sum cksum; do
        command -v "$hasher" >/dev/null 2>&1 && break
        hasher=''
    done
    [[ -n $hasher ]] || return 1

    ##  Names are hashed alongside contents, so adding, removing or renaming a
    ##  payload file changes the hash too -- not just editing one.  Sorted so
    ##  the result does not depend on glob order.
    {
        for f in "$dir"/keybindings.json \
                 "$dir"/settings-fragment.json \
                 "$dir"/brief-slickedit-helpers-*.vsix \
                 "$dir"/fonts/*.ttf; do
            [[ -f $f ]] || continue
            printf '%s ' "${f#"$dir"/}"
            "$hasher" < "$f"
        done
    } | LC_ALL=C sort | "$hasher" | awk '{print $1}'
}

write_vscode_stamp() {
    local hash="$1"
    [[ -n $hash ]] || return 0
    mkdir -p "$VSCODE_STAMP_DIR" 2>/dev/null || return 1
    printf '%s\n' "$hash" > "$VSCODE_STAMP"
}

check_vscode_setup() {
    local dir="$SCRIPT_DIR/$VSCODE_DIR_NAME"
    local shown shipped stamped='' healthy=0
    shown=$(tildify "$dir")

    ##------------------------------------------------------------------------
    ##  Not every machine running this setup is a desktop.  No VS Code and no
    ##  vscode-setup folder are both "nothing to do here", so say nothing --
    ##  same reasoning as a group that does not exist on this box.
    ##------------------------------------------------------------------------
    [[ -d $dir ]] || return 0
    command -v code >/dev/null 2>&1 || return 0

    if [[ ! -r $dir/check-install.sh ]]; then
        red "ERROR: $shown has no readable check-install.sh."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    bash "$dir/check-install.sh" >/dev/null 2>&1 && healthy=1
    shipped=$(vscode_payload_hash "$dir") || shipped=''
    [[ -r $VSCODE_STAMP ]] && stamped=$(cat "$VSCODE_STAMP")

    ##------------------------------------------------------------------------
    ##  No hashing tool at all.  Report the install honestly and say plainly
    ##  that folder changes cannot be spotted, rather than implying they can.
    ##------------------------------------------------------------------------
    if (( healthy )) && [[ -z $shipped ]]; then
        green "VS Code setup healthy (check-install.sh clean)"
        complain warn "no sha256sum/md5sum/cksum here, so changes to $shown cannot be detected."
        return 1
    fi

    if (( healthy )) && [[ -n $shipped && $shipped == "$stamped" ]]; then
        green "VS Code setup healthy and up to date with $shown"
        return 0
    fi

    ##------------------------------------------------------------------------
    ##  Healthy but never stamped: a machine set up before stamping existed.
    ##  Adopt the current state rather than forcing a pointless reinstall --
    ##  but only if the one thing check-install.sh downgrades to a warning,
    ##  the active keybindings.json, really does match what ships here.
    ##------------------------------------------------------------------------
    if (( healthy )) && [[ -z $stamped ]] \
       && diff -q "$dir/keybindings.json" "$VSCODE_USER_DIR/keybindings.json" >/dev/null 2>&1; then
        if write_vscode_stamp "$shipped"; then
            green "VS Code setup healthy, and recorded as installed from $shown"
            return 0
        fi
        green "VS Code setup healthy (check-install.sh clean)"
        complain warn "could not write $(tildify "$VSCODE_STAMP"), so changes will be re-reported."
        return 1
    fi

    if (( healthy )); then
        ##--------------------------------------------------------------------
        ##  This is the copied-back-from-another-machine case: nothing is
        ##  broken, but what is installed is not what this folder now ships.
        ##--------------------------------------------------------------------
        yellow "WARNING: $shown has changed since this machine was set up from it."
        cont "Nothing is broken, but the installed config is not what this folder"
        cont "now ships -- keybindings, font settings or the .vsix have moved on."
    else
        yellow "WARNING: the VS Code setup needs installing or repairing."
        cont "Running $shown/check-install.sh will show what is wrong."
    fi

    if [[ ! -x $dir/install.sh && ! -r $dir/install.sh ]]; then
        red "ERROR: $shown has no install.sh to run."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  install.sh has its own preflight that refuses to run while VS Code is
    ##  open (installing then is what silently loses the extension).  Check it
    ##  here too, so the answer is a clear message rather than init appearing
    ##  to stall on install.sh's own prompt.
    ##------------------------------------------------------------------------
    if pgrep -f "code.*--type=renderer" >/dev/null 2>&1; then
        red "ERROR: VS Code is running, so the installer cannot be run safely."
        cont "Quit VS Code completely (every window) and re-run this script."
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    if ! confirm "  Run $shown/install.sh now?"; then
        red "ERROR: the VS Code setup was left unconfigured."
        cont "Install it later with:"
        cont "    cd $shown && bash install.sh"
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  install.sh expects to be run from its own directory, and its output is
    ##  worth showing: it is long-running and does the font work.
    ##------------------------------------------------------------------------
    if ! ( cd "$dir" && bash ./install.sh ); then
        red "ERROR: $shown/install.sh failed."
        cont "Re-run it directly to see where:"
        cont "    cd $shown && bash install.sh"
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  Trust the check, not the installer's exit code.
    ##------------------------------------------------------------------------
    if bash "$dir/check-install.sh" >/dev/null 2>&1; then
        ##--------------------------------------------------------------------
        ##  Re-hash rather than reusing the value from earlier: install.sh may
        ##  have taken a while, and stamping something that is no longer what
        ##  is on disk would hide the next real change.
        ##--------------------------------------------------------------------
        write_vscode_stamp "$(vscode_payload_hash "$dir")" \
            || complain warn "could not write $(tildify "$VSCODE_STAMP")."
        green "VS Code setup installed and healthy"
        yellow "WARNING: start VS Code, then re-run check-install.sh."
        cont "The stale-copy reclaim happens on that first startup, so the"
        cont "clean bill of health only means something afterwards."
        WARNINGS=$((WARNINGS + 1))
        return 0
    fi

    red "ERROR: install.sh ran but $shown/check-install.sh still reports problems."
    cont "See what is wrong with:"
    cont "    cd $shown && bash check-install.sh"
    ERRORS=$((ERRORS + 1))
    return 1
}


##============================================================================
##  Group memberships this setup needs.
##
##  NOTE: the array is deliberately not called GROUPS -- that name is a bash
##  builtin array and assigning to it is an error.
##
##      dialout -- read/write access to serial and USB-serial devices, which
##                 is what the firmware work talks to
##      i2c     -- access to /dev/i2c-*, which ddcutil needs to drive the
##                 monitor input switching in .aliases
##============================================================================
REQUIRED_GROUPS=(dialout i2c)

##----------------------------------------------------------------------------
##  Two different questions, and the difference matters:
##
##      in_group_system -- is the user in the group according to /etc/group?
##                         This is the thing init can actually change.
##      in_group_now    -- does the CURRENT login session carry the group?
##                         A session started before the change will not, and
##                         no amount of re-running init will fix that; only
##                         logging out and back in will.
##----------------------------------------------------------------------------
in_group_system() { id -nG "$2" 2>/dev/null | tr ' ' '\n' | grep -qx -- "$1"; }
in_group_now()    { id -nG      2>/dev/null | tr ' ' '\n' | grep -qx -- "$1"; }

check_group() {
    local group="$1" user
    user=$(id -un)

    ##------------------------------------------------------------------------
    ##  No such group on this machine.  There is nothing to join and nothing
    ##  here needs it, so say nothing at all rather than nagging about a group
    ##  that is simply not part of this box.
    ##------------------------------------------------------------------------
    if ! getent group "$group" >/dev/null 2>&1; then
        return 0
    fi

    if in_group_system "$group" "$user"; then
        if in_group_now "$group"; then
            green "$user is in the '$group' group"
            return 0
        fi

        ##--------------------------------------------------------------------
        ##  Already fixed in /etc/group, just not in this session.  Yellow, not
        ##  red: nothing is wrong on disk and re-running init cannot help.
        ##--------------------------------------------------------------------
        complain warn "$user is in the '$group' group, but this login session started before that."
        cont "Log out and back in for it to take effect."
        return 1
    fi

    yellow "WARNING: $user is not in the '$group' group."

    if ! command -v sudo >/dev/null 2>&1; then
        red "ERROR: sudo is not available, so '$group' cannot be added here."
        cont "Get root some other way and run:"
        cont "    usermod -aG $group $user"
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    if confirm "  Add $user to '$group' now? (needs your sudo password)"; then
        if sudo usermod -aG "$group" "$user"; then
            green "$user added to the '$group' group"
            yellow "WARNING: log out and back in before it takes effect."
            WARNINGS=$((WARNINGS + 1))
            return 0
        fi

        red "ERROR: could not add $user to the '$group' group."
        cont "Try it by hand:"
        cont "    sudo usermod -aG $group $user"
        ERRORS=$((ERRORS + 1))
        return 1
    fi

    red "ERROR: $user is still not in the '$group' group."
    cont "Add it later with:"
    cont "    sudo usermod -aG $group $user"
    ERRORS=$((ERRORS + 1))
    return 1
}


##============================================================================
##  bin/ -- the execute bit
##============================================================================
##  bin/ holds scripts that get found through PATH, so they have to carry the
##  execute bit.  A round trip through a USB stick loses it: both sticks are
##  vfat, mounted fmask=0022,showexec, which cannot store the bit at all, so
##  anything copied back lands as 644 and `git trunk` becomes "command not
##  found" with no obvious cause.
##
##  The trap: chmod on vfat *succeeds* -- exit status 0 -- and changes nothing.
##  Verified on both sticks 2026-08-26.  So every fix is re-tested with -x
##  rather than trusted, and a copy running from a stick says so plainly
##  instead of reporting a failure that cannot be acted on from there.
##----------------------------------------------------------------------------
check_bin() {
    local bin="$SCRIPT_DIR/bin" f name fstype
    local -a fixed=() stuck=()
    local total=0

    ##  No bin/ at all is not a problem to report -- there is nothing to run.
    [[ -d $bin ]] || return 0

    for f in "$bin"/*; do
        [[ -f $f ]] || continue

        ##  Only files that declare an interpreter.  bin/ is for scripts, and a
        ##  stray README has no business coming out executable.
        [[ $(head -c 2 -- "$f" 2>/dev/null) == '#!' ]] || continue

        total=$((total + 1))
        [[ -x $f ]] && continue

        name=${f##*/}
        chmod +x -- "$f" 2>/dev/null
        if [[ -x $f ]]; then
            fixed+=("$name")
        else
            stuck+=("$name")
        fi
    done

    (( total > 0 )) || return 0

    if (( ${#stuck[@]} == 0 )); then
        if (( ${#fixed[@]} == 0 )); then
            green "all $total script(s) in bin/ are executable"
        else
            ##------------------------------------------------------------------
            ##  Not-executable-then-fixed is green, not yellow: it is right now,
            ##  and a re-run will find nothing to do.
            ##------------------------------------------------------------------
            green "bin/: made ${#fixed[@]} of $total script(s) executable (${fixed[*]})"
        fi
        return 0
    fi

    fstype=$(stat -f -c %T -- "$bin" 2>/dev/null) || fstype="unknown"
    if [[ $fstype == msdos || $fstype == exfat ]]; then
        ##--------------------------------------------------------------------
        ##  Nothing is broken and nothing can be fixed: this filesystem cannot
        ##  hold the bit, and PATH scripts are not run from a stick anyway.
        ##--------------------------------------------------------------------
        complain warn "bin/ is on $fstype, which cannot store the execute bit."
        cont "Harmless here -- PATH scripts run from ~/.linuxjjk/bin, not from this copy."
        cont "Copy back to \$HOME and run that copy's init to set the bit."
        return 1
    fi

    complain error "chmod +x failed on ${#stuck[@]} of $total script(s) in bin/: ${stuck[*]}"
    cont "In $(tildify "$bin") -- check ownership and the mount's options."
    return 1
}


##============================================================================
##  The Cinnamon shortcut that switches the monitor to DisplayPort.
##
##  bin/go_home_helper.sh travels with this directory, but the key that runs it
##  lives in dconf, which does not.  Without this, a fresh machine ends up with
##  the script and no way to fire it.
##
##  Both accelerators go on ONE shortcut so that NumLock does not matter: X
##  delivers KP_7 with NumLock on and KP_Home with it off.  <Primary> is how
##  Cinnamon spells Ctrl.
##============================================================================
CINNAMON_SHORTCUT_NAME='Monitor to DisplayPort (home)'
CINNAMON_SHORTCUT_SCRIPT='bin/go_home_helper.sh'
CINNAMON_SHORTCUT_KEYS=('<Primary><Alt>KP_Home' '<Primary><Alt>KP_7')

CINNAMON_SCHEMA='org.cinnamon.desktop.keybindings'
CINNAMON_CUSTOM_SCHEMA="$CINNAMON_SCHEMA.custom-keybinding"
CINNAMON_CUSTOM_PATH='/org/cinnamon/desktop/keybindings/custom-keybindings'

##----------------------------------------------------------------------------
##  Can a Cinnamon shortcut be installed here at all?
##
##  The test is the schemas, NOT $XDG_CURRENT_DESKTOP: this script gets run
##  from a TTY and over ssh, where that variable is empty even on the Cinnamon
##  box, and the schema is what decides whether the write can land.  The
##  per-entry schema is relocatable, so it appears in a different list.
##----------------------------------------------------------------------------
cinnamon_is_available() {
    command -v gsettings >/dev/null 2>&1 || return 1
    gsettings list-schemas 2>/dev/null |
        grep -qx -- "$CINNAMON_SCHEMA" || return 1
    gsettings list-relocatable-schemas 2>/dev/null |
        grep -qx -- "$CINNAMON_CUSTOM_SCHEMA"
}

##----------------------------------------------------------------------------
##  The schema:path pair that addresses one shortcut slot.
##----------------------------------------------------------------------------
cinnamon_custom_schema() {
    printf '%s:%s/%s/' "$CINNAMON_CUSTOM_SCHEMA" "$CINNAMON_CUSTOM_PATH" "$1"
}

##----------------------------------------------------------------------------
##  Split a gsettings string-array value into one item per line.
##
##  gsettings prints a GVariant -- ['custom0', 'custom1'] -- or the typed form
##  "@as []" when the value is empty, so the type annotation, the brackets and
##  the quoting all have to come off.  Neither slot names nor accelerators can
##  contain a comma or a quote, which is what makes splitting this simple.
##----------------------------------------------------------------------------
cinnamon_split_array() {
    sed -e 's/^@as //' -e 's/^\[//' -e 's/\]$//' |
        tr ',' '\n' |
        sed -e "s/^ *'//" -e "s/' *$//" |
        grep -v '^$'
}

##----------------------------------------------------------------------------
##  The slots Cinnamon actually honors, one per line.  A slot missing from
##  custom-list is ignored no matter what is written at its path, which is why
##  every lookup starts here rather than at a path.
##----------------------------------------------------------------------------
cinnamon_custom_list() {
    gsettings get "$CINNAMON_SCHEMA" custom-list 2>/dev/null | cinnamon_split_array
}

##----------------------------------------------------------------------------
##  Which listed slot runs this command, if any.
##
##  The command is the identity, not the slot name: Cinnamon's settings panel
##  hands out slots first-free, so the same shortcut can be custom1 here and
##  custom4 on the next machine.
##----------------------------------------------------------------------------
cinnamon_slot_for_command() {
    local want="$1" slot cmd
    while read -r slot; do
        cmd=$(gsettings get "$(cinnamon_custom_schema "$slot")" command 2>/dev/null) || continue
        cmd=${cmd#\'}
        cmd=${cmd%\'}
        if [[ $cmd == "$want" ]]; then
            printf '%s\n' "$slot"
            return 0
        fi
    done < <(cinnamon_custom_list)
    return 1
}

##----------------------------------------------------------------------------
##  Which of the wanted accelerators this slot is not carrying, one per line.
##----------------------------------------------------------------------------
cinnamon_missing_keys() {
    local schema="$1" binding key
    binding=$(gsettings get "$schema" binding 2>/dev/null) || binding=''
    for key in "${CINNAMON_SHORTCUT_KEYS[@]}"; do
        [[ $binding == *"'$key'"* ]] || printf '%s\n' "$key"
    done
}

##----------------------------------------------------------------------------
##  Build the ['a', 'b'] literal that gsettings wants from plain arguments.
##----------------------------------------------------------------------------
cinnamon_gvariant_array() {
    local out='' item
    for item in "$@"; do
        out+="${out:+, }'$item'"
    done
    printf '[%s]' "$out"
}

##----------------------------------------------------------------------------
##  Write a whole shortcut into a free slot.
##
##  custom-list is set LAST, on purpose: Cinnamon honors only what is listed,
##  so the name, command and binding are all in place before the entry goes
##  live.  The other order would briefly publish an empty shortcut.
##----------------------------------------------------------------------------
cinnamon_install_shortcut() {
    local script="$1" slot="$2" schema
    schema=$(cinnamon_custom_schema "$slot")

    gsettings set "$schema" name    "$CINNAMON_SHORTCUT_NAME" 2>/dev/null || return 1
    gsettings set "$schema" command "$script"                 2>/dev/null || return 1
    gsettings set "$schema" binding \
              "$(cinnamon_gvariant_array "${CINNAMON_SHORTCUT_KEYS[@]}")" 2>/dev/null || return 1

    local -a listed=()
    local line
    while read -r line; do listed+=("$line"); done < <(cinnamon_custom_list)
    listed+=("$slot")
    gsettings set "$CINNAMON_SCHEMA" custom-list \
              "$(cinnamon_gvariant_array "${listed[@]}")" 2>/dev/null
}

##----------------------------------------------------------------------------
##  The lowest customN that custom-list is not already using.
##----------------------------------------------------------------------------
cinnamon_free_slot() {
    local -a listed=()
    local line n=0
    while read -r line; do listed+=("$line"); done < <(cinnamon_custom_list)

    while (( n < 100 )); do
        if ! printf '%s\n' ${listed[@]+"${listed[@]}"} | grep -qx -- "custom$n"; then
            printf 'custom%d\n' "$n"
            return 0
        fi
        n=$((n + 1))
    done
    return 1
}

check_cinnamon_keybindings() {
    local script="$SCRIPT_DIR/$CINNAMON_SHORTCUT_SCRIPT"
    local shown keys slot schema
    shown=$(tildify "$script")
    keys="${CINNAMON_SHORTCUT_KEYS[*]}"

    ##------------------------------------------------------------------------
    ##  Not Cinnamon.  Yellow, not red: nothing is broken and nothing here can
    ##  be fixed -- the same call check_bin makes for a stick that cannot hold
    ##  the execute bit.
    ##------------------------------------------------------------------------
    if ! cinnamon_is_available; then
        complain warn "not running Cinnamon (XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-none}), so the"
        cont "monitor-input keybinding cannot be installed."
        cont "$shown still works when run by hand."
        return 1
    fi

    if [[ ! -f $script ]]; then
        complain error "$shown is missing, so there is nothing for a keybinding to run."
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  A shortcut records an absolute path, so one pointing into a copy
    ##  outside $HOME dies the moment that copy goes away.
    ##------------------------------------------------------------------------
    if [[ $script != "$HOME"/* ]]; then
        complain warn "this copy is outside \$HOME, so a shortcut pointing at $script"
        cont "would break as soon as it is unmounted."
        cont "Copy back to \$HOME and run that copy's init."
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  Nothing installed yet.  Write it, then prove it by reading it back --
    ##  gsettings exiting 0 is not the same as the value being there.
    ##------------------------------------------------------------------------
    if ! slot=$(cinnamon_slot_for_command "$script"); then
        if ! slot=$(cinnamon_free_slot); then
            complain error "no free custom shortcut slot for the monitor-input keybinding."
            return 1
        fi

        cinnamon_install_shortcut "$script" "$slot"

        if slot=$(cinnamon_slot_for_command "$script") &&
           [[ -z $(cinnamon_missing_keys "$(cinnamon_custom_schema "$slot")") ]]; then
            ##----------------------------------------------------------------
            ##  Missing-then-created is green: it is right now, and a re-run
            ##  will find nothing to do.
            ##----------------------------------------------------------------
            green "Cinnamon shortcut installed as $slot: $keys -> $shown"
            return 0
        fi

        complain error "could not install the Cinnamon shortcut for $shown."
        cont "Add it by hand in Keyboard -> Shortcuts -> Custom Shortcuts:"
        cont "    $keys"
        return 1
    fi

    ##------------------------------------------------------------------------
    ##  The shortcut is there.  Only the accelerators it is actually missing
    ##  get added, so a third one added by hand in the settings panel survives.
    ##------------------------------------------------------------------------
    schema=$(cinnamon_custom_schema "$slot")

    local -a missing=()
    local line
    while read -r line; do missing+=("$line"); done < <(cinnamon_missing_keys "$schema")

    if (( ${#missing[@]} == 0 )); then
        green "Cinnamon shortcut $slot is bound: $keys -> $shown"
        return 0
    fi

    local -a binding=()
    while read -r line; do binding+=("$line"); done \
        < <(gsettings get "$schema" binding 2>/dev/null | cinnamon_split_array)
    binding+=("${missing[@]}")

    gsettings set "$schema" binding \
              "$(cinnamon_gvariant_array ${binding[@]+"${binding[@]}"})" 2>/dev/null

    if [[ -z $(cinnamon_missing_keys "$schema") ]]; then
        green "Cinnamon shortcut $slot: added ${missing[*]}"
        return 0
    fi

    complain error "could not add ${missing[*]} to Cinnamon shortcut $slot."
    cont "Add it by hand in Keyboard -> Shortcuts -> Custom Shortcuts."
    return 1
}


##============================================================================
##  Main
##============================================================================
info "Initializing from $(tildify "$SCRIPT_DIR")"
info ""

if ! command -v git >/dev/null 2>&1; then
    red "ERROR: git is not installed, so none of the git checks can run."
    cont "Install git and re-run this script."
    exit 1
fi

check_gitid

##----------------------------------------------------------------------------
##  A wrong ~/.gitconfig is an error -- git silently commits under the wrong
##  identity or with the wrong tooling.  A wrong ~/.aliases only costs some
##  convenience functions, so that one is a warning.
##----------------------------------------------------------------------------
check_portable_symlink "$HOME/.gitconfig" "$SCRIPT_DIR/.gitconfig" error
check_portable_symlink "$HOME/.aliases"   "$SCRIPT_DIR/.aliases"   warn

check_bashrc_hook
check_vscode_setup
check_bin
check_cinnamon_keybindings

##----------------------------------------------------------------------------
##  Groups last: they are the only checks that need a password, so everything
##  that can be done without one is already done and reported by this point.
##----------------------------------------------------------------------------
for _group in "${REQUIRED_GROUPS[@]}"; do
    check_group "$_group"
done

info ""
if (( ERRORS > 0 )); then
    red "$ERRORS error(s), $WARNINGS warning(s)."
    exit 1
elif (( WARNINGS > 0 )); then
    yellow "$WARNINGS warning(s)."
    exit 0
else
    green "All checks passed."
    exit 0
fi
