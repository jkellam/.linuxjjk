#!/usr/bin/env python3
"""git fsl -- this branch's own commits, back to where it left its base."""

import os
import sys

##  No __pycache__ in bin/: it saves nothing measurable (the whole command runs
##  in ~40 ms either way) and would show up forever as a difference when bin/ is
##  diffed against the USB copies.  It has to be set here rather than inside
##  jjk_gitlog, which cannot do it for itself -- the loader compiles and caches a
##  module before running its body.
sys.dont_write_bytecode = True

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from jjk_gitlog import git, screen_log, trunk_name

def fallback_bases():
    """What to measure against when there is no upstream, best guess first.

    trunk_name() leads, so an origin/master repo is not searched for main
    first -- but the others stay in the list, because a branch can sit on a
    trunk that origin/HEAD does not point at."""
    trunk = trunk_name()
    ordered = [trunk, "origin/" + trunk,
               "main", "master", "origin/main", "origin/master"]
    return list(dict.fromkeys(ordered))          # dedup, order kept


def revs():
    """Everything since this branch left its base.

    The upstream is the first choice.  If there is none, or if the merge base
    with it is HEAD itself (nothing to show), fall back through the usual trunk
    names.  Ending at BASE^ rather than BASE is deliberate: it puts the commit
    the branch grew from on screen as an anchor.
    """
    head = git("rev-parse", "HEAD")
    if head is None:
        return []                      # no commits yet; let git log say so

    base = None
    upstream = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream:
        base = git("merge-base", "HEAD", upstream)

    if base is None or base == head:
        for candidate in fallback_bases():
            if git("rev-parse", "--verify", "-q", candidate) is None:
                continue
            found = git("merge-base", "HEAD", candidate)
            if found and found != head:
                base = found
                break

    if base is None:
        base = head

    ##  A root commit has no parent, and BASE^..HEAD is then just "everything",
    ##  which is what plain HEAD asks for.
    if git("rev-parse", "--verify", "-q", base + "^") is None:
        return ["HEAD"]
    return [base + "^..HEAD"]


sys.exit(screen_log(
    name="fsl",
    blurb="this branch's own commits, back to where it left its base",
    revs=revs,
))
