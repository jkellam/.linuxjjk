pid_runs_executable() {
    #   pid_runs_executable <pid> <canonical-executable>
    # 1 = <pid> is running it, 0 = not, or no such process.
    local pid=$1
    local target=$2

    [ "$pid" -gt 0 ] 2>/dev/null || return 0

    local exe
    exe=$(ps -o args= -p "$pid" 2>/dev/null | awk 'NR == 1 { print $1 }')
    [ -n "$exe" ] || return 0
    exe=$(realpath -e -- "$exe" 2>/dev/null) || return 0
    [ "$exe" = "$target" ] && return 1

    return 0
}


is_on_current_desktop_cinnamon() {
    #   is_on_current_desktop_cinnamon <canonical-executable> <status-when-unknown>
    # Only the X11 session can be read; anything else is unknown.
    local target=$1
    local unknown=$2

    local desktop
    desktop=$(wmctrl -d 2>/dev/null | awk '$2 == "*" { print $1 }')
    [ -n "$desktop" ] || return "$unknown"

    # wmctrl -lpx columns: <id> <desktop> <pid> <WM_CLASS> <host> <title>.
    # Sticky windows report desktop -1.
    local pid
    while read -r pid; do
        pid_runs_executable "$pid" "$target" || return 1
    done < <(wmctrl -lpx 2>/dev/null |
                 awk -v d="$desktop" '$2 == d || $2 == "-1" { print $3 }')

    return 0
}


is_on_current_desktop_plasma() {
    #   is_on_current_desktop_plasma <canonical-executable> <status-when-unknown>
    # Plasma 6 only.  Asks KWin through kdotool 0.3.0+ (for kwinscript), so
    # native Wayland windows count as well as X11 ones.  A window counts when
    # it is on both the current desktop and the current activity.
    local target=$1
    local unknown=$2

    command -v kdotool >/dev/null 2>&1 || return "$unknown"

    # An empty desktops or activities list means the window is on all of them.
    local script='
const desktop = workspace.currentDesktop.id;
const activity = workspace.currentActivity;
for (const w of workspace.windowList()) {
    if (w.desktops.length && !w.desktops.some(d => d.id === desktop)) continue;
    if (w.activities.length && !w.activities.includes(activity)) continue;
    output_result(w.pid);
}'

    local pids
    pids=$(timeout 5 kdotool kwinscript --inline "$script" 2>/dev/null) || return "$unknown"

    local pid
    while read -r pid; do
        pid_runs_executable "$pid" "$target" || return 1
    done <<< "$pids"

    return 0
}


is_on_current_desktop() {
    # Is <executable> the process behind any window on the visible desktop?
    #   is_on_current_desktop <executable> [status-when-unknown]
    # 1 = yes, 0 = no, status-when-unknown (default 0) if it can't be told.
    local target=$1
    local unknown=${2:-0}

    # Backends compare canonical paths.
    target=$(realpath -e -- "$target" 2>/dev/null) || return "$unknown"

    case ",${XDG_CURRENT_DESKTOP,,}," in
        *cinnamon*)
            is_on_current_desktop_cinnamon "$target" "$unknown"
            ;;
        *plasma*|*kde*)
            is_on_current_desktop_plasma "$target" "$unknown"
            ;;
        *)
            return "$unknown"
            ;;
    esac
}


gitbranch() {
    local branch_output
    branch_output=$(git branch 2>/dev/null) || return 0

    local the_branch
    the_branch=$(printf '%s\n' "$branch_output" | grep -E '^\*.')

    if [[ $(printf '%s\n' "$the_branch" | grep -cE '^\*.') -eq 1 ]]; then
        the_branch="${the_branch#\*}"
        the_branch="${the_branch#"${the_branch%%[![:space:]]*}"}"
        the_branch="${the_branch%"${the_branch##*[![:space:]]}"}"
        if [[ "$the_branch" == users/banshee/* ]]; then
            echo "(~/${the_branch#users/banshee/})"
        else
            echo "($the_branch)"
        fi
    fi
}


hgbookmark() {
    return 0
}


cgrep() {
    if [[ $# -ne 1 ]]; then
        echo Usage: cgrep \<pattern\> 1>&2
    else
        grep -r --include="*.h" --include="*.c" "$1" .
    fi
}


cgrepi() {
    if [[ $# -ne 1 ]]; then
        echo Usage: cgrepi \<pattern\> 1>&2
    else
        grep -r --ignore-case --include="*.h" --include="*.c" "$1" .
    fi
}


hgrep() {
    if [[ $# -ne 1 ]]; then
        echo Usage: hgrep \<pattern\> 1>&2
    else
        grep -r --include="*.h" "$1" .
    fi
}


hgrepi() {
    if [[ $# -ne 1 ]]; then
        echo Usage: hgrepi \<pattern\> 1>&2
    else
        grep -r --ignore-case --include="*.h" "$1" .
    fi
}


cppgrep() {
    if [[ $# -ne 1 ]]; then
        echo Usage: cppgrep \<pattern\> 1>&2
    else
        grep -r --include="*.h" --include="*.hpp" --include="*.c" --include="*.cpp" --include="*.cxx" "$1" .
    fi
}


cppgrepi() {
